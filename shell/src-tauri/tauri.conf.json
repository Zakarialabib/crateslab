{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cratelab",
  "version": "0.1.0",
  "identifier": "rs.zakarialabib.cratelab",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cratelab — the crate bench",
        "width": 1360,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
